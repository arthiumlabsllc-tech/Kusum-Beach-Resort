# =============================================
# KUSUM BEACH MANAGEMENT PLATFORM
# Environment Configuration
# =============================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://kusum_user:kusum_password@localhost:5432/kusum_beach?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Payment Integrations

# MTN MoMo API
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_PRIMARY_KEY=your_mtn_primary_key

# Vodafone Cash
VODAFONE_API_URL=https://api.vodafone.com.gh
VODAFONE_API_KEY=your_vodafone_api_key

# Breet (Crypto/Stablecoin)
BREET_API_URL=https://api.breet.com
BREET_API_KEY=your_breet_api_key

# SMS - Africa's Talking
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SHORTCODE=your_shortcode

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@kusumbeach.com

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
